OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
VAD_SILENCE_MS=800

# Database Configuration
# The backend connects to the PostgreSQL database running inside the Docker network.
# It uses the service name "db" and the internal Docker port "5432".
# Do not use "localhost" or the host port (e.g. 5434) here.
DATABASE_URL=postgresql+asyncpg://voxai:voxai_password@db:5432/voxai_db
